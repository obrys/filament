variant: fcos
version: 1.5.0

# Butane → Ignition source for the Filament server.
# Render with:
#   podman run --rm -i quay.io/coreos/butane:release \
#     < deploy/ignition/filament.bu > deploy/ignition/filament.ign

passwd:
  users:
    - name: filament
      ssh_authorized_keys:
        - ssh-rsa 
      password_hash: "$6$jnszgvwl7FV0pKb.$ImibxV7gfwAHv9sDftxEkSnux/.3YAMRJSgHKFgLwMNYEHWfADHjpb7Iy9ZP78Q6qWVSv4Yk/WqhpKjjz2mAe0"  # optional; `openssl passwd -6`
    - name: obrys
      groups:
        - sudo
        - wheel
      ssh_authorized_keys:
        - ssh-rsa 
      password_hash: "$6$jnszgvwl7FV0pKb.$ImibxV7gfwAHv9sDftxEkSnux/.3YAMRJSgHKFgLwMNYEHWfADHjpb7Iy9ZP78Q6qWVSv4Yk/WqhpKjjz2mAe0"  # optional; `openssl passwd -6`

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: web

    # Lower journald retention to save disk on a small VM
    - path: /etc/systemd/journald.conf.d/size.conf
      mode: 0644
      contents:
        inline: |
          [Journal]
          SystemMaxUse=200M
          RuntimeMaxUse=50M

    # Allow short-name docker.io fallback so podman pulls work even if
    # someone forgets to fully-qualify an image name.
    - path: /etc/containers/registries.conf.d/00-unqualified.conf
      mode: 0644
      contents:
        inline: |
          unqualified-search-registries = ["docker.io"]

    # Quadlet target directory for the filament user (created idempotently)
    - path: /var/home/filament/.config/containers/systemd/.keep
      mode: 0644
      user:
        name: filament
      group:
        name: filament
      contents:
        inline: ""

  links:
    - path: /etc/localtime
      target: /usr/share/zoneinfo/Europe/Prague   # << adjust to your timezone
      overwrite: true

systemd:
  units:
    # Enable lingering so the filament user's --user services run at boot
    # without an interactive login session.
    - name: linger-filament.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable systemd lingering for filament user
        After=systemd-user-sessions.service
        ConditionPathExists=!/var/lib/systemd/linger/filament

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/loginctl enable-linger filament
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target
